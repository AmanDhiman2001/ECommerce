@model Project_Ecomm_Offical.Models.ShoppingCart
@{
    ViewData["Title"] = "Product Details";
}

<form method="post">
    <input type="hidden" asp-for="ProductId" />

    <div class="card details-card">
        <div class="card-header details-header row g-3 align-items-center">
            <div class="col-md-7">
                <h1 class="h3 mb-1">@Model.Product.Title</h1>
                <p class="mb-0">by @Model.Product.Author</p>
            </div>
            <div class="col-md-5 text-md-end">
                <span class="badge text-bg-light me-2">@Model.Product.CoverType.Name</span>
                <span class="badge text-bg-light">@Model.Product.Category.Name</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <p class="text-muted mb-2"><strong>ISBN:</strong> @Model.Product.ISBN</p>
                    <p class="mb-4">List Price: <strike>@Model.Product.ListPrice.ToString("C")</strike></p>

                    <div class="price-table mb-4">
                        <div class="row text-center g-2">
                            <div class="col-3"><div class="cell">Qty</div></div>
                            <div class="col-3"><div class="cell">1-49</div></div>
                            <div class="col-3"><div class="cell">50-99</div></div>
                            <div class="col-3"><div class="cell">100+</div></div>
                        </div>
                        <div class="row text-center g-2 mt-1">
                            <div class="col-3"><div class="cell">Price</div></div>
                            <div class="col-3"><div class="cell text-danger">@Model.Product.Price.ToString("C")</div></div>
                            <div class="col-3"><div class="cell text-danger">@Model.Product.Price50.ToString("C")</div></div>
                            <div class="col-3"><div class="cell text-danger">@Model.Product.Price100.ToString("C")</div></div>
                        </div>
                    </div>

                    <div class="mb-4 text-secondary">@Html.Raw(Model.Product.Description)</div>

                    <div class="row align-items-center g-2">
                        <div class="col-sm-3">
                            <label asp-for="Count" class="fw-semibold">Quantity</label>
                        </div>
                        <div class="col-sm-9">
                            <input class="form-control" asp-for="Count" min="1" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 text-center">
                    <img src="@Model.Product.ImageUrl" class="img-fluid product-preview" alt="@Model.Product.Title" />
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-3">
            <div class="row g-2">
                <div class="col-md-6">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to Catalog</a>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</form>
