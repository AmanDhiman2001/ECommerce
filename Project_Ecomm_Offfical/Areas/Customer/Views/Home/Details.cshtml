@model Project_Ecomm_Offical.Models.ShoppingCart
@{
    ViewData["Title"] = "Details";
}

<form method="post">
    <input type="hidden" asp-for="@Model.ProductId" />

    <div class="card product-details-card">
        <div class="card-header bg-white border-0 p-4 pb-0">
            <div class="row g-3 align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-1">@Model.Product.Title</h2>
                    <p class="text-muted mb-0">by @Model.Product.Author</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <span class="product-meta-chip">@Model.Product.CoverType.Name</span>
                    <span class="product-meta-chip">@Model.Product.Category.Name</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <p class="text-muted mb-2">ISBN: <span class="fw-semibold">@Model.Product.ISBN</span></p>
                    <p class="mb-3">List Price: <strike>@Model.Product.ListPrice.ToString("C")</strike></p>

                    <div class="pricing-grid mb-4">
                        <div class="row g-2 text-center fw-semibold">
                            <div class="col-3"><div class="cell">Qty</div></div>
                            <div class="col-3"><div class="cell">1-49</div></div>
                            <div class="col-3"><div class="cell">50-99</div></div>
                            <div class="col-3"><div class="cell">100+</div></div>
                        </div>
                        <div class="row g-2 text-center mt-1">
                            <div class="col-3"><div class="cell fw-bold">Price</div></div>
                            <div class="col-3"><div class="cell text-success fw-bold">@Model.Product.Price.ToString("C")</div></div>
                            <div class="col-3"><div class="cell text-success fw-bold">@Model.Product.Price50.ToString("C")</div></div>
                            <div class="col-3"><div class="cell text-success fw-bold">@Model.Product.Price100.ToString("C")</div></div>
                        </div>
                    </div>

                    <div class="mb-4 text-secondary">@Html.Raw(Model.Product.Description)</div>

                    <label asp-for="Count" class="form-label fw-semibold">Quantity</label>
                    <input class="form-control" asp-for="Count" min="1" />
                </div>

                <div class="col-lg-4 text-center">
                    <img src="@Model.Product.ImageUrl" class="img-fluid rounded-4 shadow-sm" alt="@Model.Product.Title" />
                </div>
            </div>
        </div>

        <div class="card-footer bg-white border-0 p-4 pt-0">
            <div class="row g-2">
                <div class="col-md-6">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to Catalog</a>
                </div>
                <div class="col-md-6">
                    <button type="submit" value="Add to Cart" class="btn btn-primary w-100">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</form>
